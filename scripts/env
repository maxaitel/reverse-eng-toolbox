#!/usr/bin/env bash
export TOOLBOX_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$TOOLBOX_ROOT/.venv/bin:$TOOLBOX_ROOT/.local/cargo/bin:$PATH"
export CARGO_HOME="$TOOLBOX_ROOT/.local/cargo" RUSTUP_HOME="$TOOLBOX_ROOT/.local/rust"
if [[ -z ${GHIDRA_INSTALL_DIR:-} ]]; then
  export GHIDRA_INSTALL_DIR="$TOOLBOX_ROOT/.local/ghidra_12.1.3_PUBLIC"
  if [[ ! -d $GHIDRA_INSTALL_DIR && $(uname -s) == Darwin ]]; then
    for toolbox_brew_prefix in /opt/homebrew /usr/local; do
      if [[ -d $toolbox_brew_prefix/opt/ghidra/libexec/Ghidra ]]; then
        export GHIDRA_INSTALL_DIR="$toolbox_brew_prefix/opt/ghidra/libexec"
        break
      fi
    done
    unset toolbox_brew_prefix
  fi
fi
export GHIDRA_INSTALL_DIR
export XDG_CACHE_HOME="$TOOLBOX_ROOT/.local/cache"
export XDG_CONFIG_HOME="$TOOLBOX_ROOT/.local/config"
export HF_HOME="$XDG_CACHE_HOME/huggingface"
export ANONYMIZED_TELEMETRY=False
